# ==================== SHELLY FLOOD GEN4 CONFIGURATION ====================

# Shelly Cloud Authentication
# Get this from: https://control.shelly.cloud/ > Settings > API
SHELLY_CLOUD_AUTH_KEY=your_shelly_cloud_auth_key_here

# Shelly Cloud Server Location (us, eu, or asia)
SHELLY_CLOUD_SERVER=us

# Comma-separated list of Shelly device IDs
# Example: device1abc123,device2def456,device3ghi789
# Get device IDs from Shelly Cloud app or API
SHELLY_DEVICE_IDS=

# Your webhook URL (for real-time alerts from Shelly Cloud)
# Example: https://your-domain.com/api/iot/shelly/webhook
# Or ngrok URL: https://abc123.ngrok.io/api/iot/shelly/webhook
SHELLY_WEBHOOK_URL=

# ==================== SETUP INSTRUCTIONS ====================
#
# 1. CREATE SHELLY CLOUD ACCOUNT:
#    - Go to https://control.shelly.cloud/
#    - Register for free account
#    - Add your Shelly Flood Gen4 devices
#
# 2. GET API CREDENTIALS:
#    - Login to Shelly Cloud
#    - Go to Settings > API
#    - Generate auth key
#    - Copy auth key to SHELLY_CLOUD_AUTH_KEY above
#
# 3. GET DEVICE IDs:
#    - In Shelly Cloud app, click on each device
#    - Copy the device ID (usually shown in device settings)
#    - Add all device IDs to SHELLY_DEVICE_IDS (comma-separated)
#
# 4. SETUP WEBHOOK (Optional - for real-time alerts):
#    - Deploy your backend to a public URL OR use ngrok
#    - Set SHELLY_WEBHOOK_URL to your webhook endpoint
#    - Webhook will automatically be configured on server start
#
# 5. TEST CONNECTION:
#    - Start server: npm run push-server
#    - Visit: http://localhost:3001/api/iot/shelly/health
#    - Should see: { status: "ok", deviceCount: X }
#
# ==================== END SHELLY CONFIGURATION ====================
