{
  "name": "houseyield",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash ./scripts/dev-maintenance.sh",
    "dev:houseyield": "bash ./scripts/dev-houseyield.sh",
    "dev:local": "node server/dev-local.js",
    "dev:simple": "concurrently --kill-others-on-fail \"vite --port 5173 --strictPort\" \"npm:push-server\"",
    "dev:internal": "bash ./scripts/dev-internal.sh",
    "dev:internal:ui": "vite --config vite.internal.config.ts --port 5174 --strictPort",
    "dev:maintenance": "bash ./scripts/dev-maintenance.sh",
    "dev:maintenance:ui": "VITE_PRODUCT_MODE=maintenance vite --config vite.maintenance.config.ts --port 5175 --strictPort",
    "build:maintenance": "vite build --config vite.maintenance.config.ts",
    "dev:tunnel": "node server/dev-with-auto-tunnel.js",
    "dev:ngrok": "concurrently --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/dev-with-ngrok-fast.js",
    "dev:server:slow": "node server/dev-with-ngrok.js",
    "backend": "node server/index.js",
    "build": "tsc && vite build",
    "build:internal": "vite build --config vite.internal.config.ts",
    "test": "vitest run",
    "test:assistant": "vitest run src",
    "test:e2e:assistant": "playwright test e2e/assistant.spec.ts",
    "preview:layout": "vitest run src/components/property/__preview__ src/components/twin/__preview__ && node scripts/shoot-preview.mjs",
    "assistant-memory:backfill": "node server/backfillAssistantMemory.js",
    "assistant-weekly-digest:batch": "node server/runAssistantWeeklyDigestBatch.js",
    "accounting-core:health": "node server/accounting-core/checkHealth.js",
    "accounting-core:migrate": "node server/accounting-core/runMigrations.js",
    "accounting-core:backfill-firestore-journals": "node server/accounting-core/backfillFirestoreJournalEntries.js",
    "accounting-core:backfill-firestore-bookkeeping-metadata": "node server/accounting-core/backfillFirestoreBookkeepingMetadata.js",
    "accounting-core:sync-tax-ruleset": "node server/accounting-core/syncTaxRuleset.js",
    "test:accounting-fixture": "node server/test-accounting-fixture.js baseline-rental-ledger && node server/test-tax-export-fixture.js prestwick-rental-2025 && node server/test-bookkeeping-shadow-fixture.js bookkeeping-shadow-paths && node server/test-stripe-shadow-fixture.js stripe-shadow-paths",
    "test:renovation-cost-backtest": "node server/test-renovation-cost-backtest.js",
    "test:accounting-cutover-fixture": "node server/test-accounting-cutover-fixture.js baseline-rental-ledger",
    "test:tax-export-fixture": "node server/test-tax-export-fixture.js prestwick-rental-2025 && node server/test-tax-engine-correctness-fixture.js && node server/test-tax-intelligence-fixture.js",
    "test:tax-over-assessment": "node server/test-tax-over-assessment-fixture.js",
    "test:rental-pricing-power": "node server/test-rental-pricing-power-fixture.js",
    "test:insurance-packet": "node server/test-insurance-packet-fixture.js",
    "test:tax-intelligence": "node server/test-tax-intelligence-fixture.js",
    "test:tax-engine-correctness": "node server/test-tax-engine-correctness-fixture.js",
    "test:accounting-fixture:write": "node server/test-accounting-fixture.js baseline-rental-ledger --write-expected && node server/test-bookkeeping-shadow-fixture.js bookkeeping-shadow-paths --write-expected && node server/test-stripe-shadow-fixture.js stripe-shadow-paths --write-expected",
    "test:bookkeeping-shadow-fixture": "node server/test-bookkeeping-shadow-fixture.js bookkeeping-shadow-paths",
    "test:bookkeeping-shadow-fixture:write": "node server/test-bookkeeping-shadow-fixture.js bookkeeping-shadow-paths --write-expected",
    "test:stripe-shadow-fixture": "node server/test-stripe-shadow-fixture.js stripe-shadow-paths",
    "test:stripe-shadow-fixture:write": "node server/test-stripe-shadow-fixture.js stripe-shadow-paths --write-expected",
    "measure:stability": "node server/scripts/measurement/roomMeasurementStability.mjs",
    "measure:benchmark": "node server/scripts/measurement/roomMeasurementBenchmark.mjs",
    "measure:benchmark:bathroom": "node server/scripts/measurement/roomMeasurementBenchmark.mjs --case bathroom-new-images2 --repeat 2",
    "smoke:master-v1:local": "node ./scripts/smoke-master-v1-local.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "push-server": "bash ./scripts/dev-houseyield.sh --backend-only",
    "gcloud:houseyield": "bash ./scripts/gcloud-houseyield.sh",
    "gcloud:houseyield:login": "bash ./scripts/gcloud-houseyield-login.sh",
    "gcloud:houseyield:adc": "bash ./scripts/gcloud-houseyield-service-account.sh",
    "gcloud:houseyield:check": "node ./scripts/check-gcloud-service-account-auth.cjs",
    "gcloud:houseyield:service-account": "bash ./scripts/gcloud-houseyield-service-account.sh",
    "gcloud:houseyield:whoami": "bash ./scripts/gcloud-houseyield.sh auth list --filter=status:ACTIVE --format='value(account)'",
    "gcloud:backend:service-account": "bash ./scripts/ensure-backend-runtime-service-account.sh",
    "gcloud:scanner:service-account": "bash ./scripts/ensure-scanner-runtime-service-account.sh",
    "deploy:backend": "bash ./deploy-backend-cloudrun.sh",
    "deploy:scanner": "bash ./deploy-scanner-host.sh",
    "gcloud:optimize-cloud-run": "bash ./scripts/optimize-cloud-run-costs.sh",
    "create:master-v1:vm": "bash ./create-master-v1-vm.sh",
    "deploy:master-v1:worker": "bash ./deploy-master-v1-pipeline.sh",
    "deploy:master-v1:global-mapper": "bash ./deploy-master-v1-global-mapper.sh",
    "refgaussian:export-bundle:vm": "node scripts/export-refgaussian-bundle-vm.mjs",
    "refgaussian:benchmark:6img": "bash scripts/launch-refgaussian-six-image-vm.sh",
    "refgaussian:compare-frame": "node scripts/compare-refgaussian-frame.mjs",
    "refgaussian:parity-report": "node scripts/refgaussian-parity-report.mjs",
    "create:renovation-measurement:vm": "bash ./create-renovation-measurement-vm.sh",
    "deploy:renovation-measurement:vm": "bash ./deploy-renovation-measurement-vm.sh",
    "setup:renovation-measurement:vm": "bash ./renovation-measurement-vm-setup.sh",
    "deploy:room-tour-worker": "bash ./deploy-room-tour-pipeline.sh",
    "ngrok": "node server/start-ngrok.js",
    "cloudflare": "cloudflared tunnel --url http://localhost:5173",
    "gen:vapid": "node server/generateVapid.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/generative-ai": "^0.24.1",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.8",
    "@stripe/react-stripe-js": "^5.4.0",
    "@stripe/stripe-js": "^8.5.2",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.0.0",
    "@types/three": "^0.160.0",
    "aedes": "^0.51.3",
    "axios": "^1.12.2",
    "better-sqlite3": "^12.4.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.5",
    "googleapis": "^163.0.0",
    "groq-sdk": "^0.37.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "http-proxy": "^1.18.1",
    "intuit-oauth": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "livekit-client": "^2.16.1",
    "lucide-react": "^0.534.0",
    "mssql": "^12.5.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.4",
    "numpy-parser": "^1.2.3",
    "openai": "^6.37.0",
    "pdf-lib": "^1.17.1",
    "plaid": "^39.0.0",
    "pngjs": "^7.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^6.15.0",
    "recharts": "^3.7.0",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "snowflake-sdk": "^2.3.3",
    "stripe": "^19.1.0",
    "three": "^0.160.1",
    "twilio": "^5.10.3",
    "uuid": "^14.0.0",
    "ws": "^8.19.0"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.6.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "concurrently": "^9.2.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "firebase-tools": "^15.2.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "web-push": "^3.6.6"
  }
}
