MOBILE_SCAN_TOKEN_SECRET=replace-with-a-long-random-secret
SCANNER_GCP_PROJECT=houseyield
SCANNER_GCP_REGION=us-central1
SCANNER_GCP_SERVICE=renovation-scanner-host
SCANNER_GCP_SERVICE_ACCOUNT_NAME=houseyield-scanner-runtime
SCANNER_GCP_SERVICE_ACCOUNT=houseyield-scanner-runtime@houseyield.iam.gserviceaccount.com
SCANNER_GCP_IAM_ACCOUNT=
SCANNER_GCP_VM_IAM_ACCOUNT=
SCANNER_GCP_CONFIG_ONLY=0
SCANNER_GCP_MIN_INSTANCES=0
SCANNER_GCP_MAX_INSTANCES=1
SCANNER_GCP_MEMORY=8Gi
SCANNER_GCP_CPU=2
SCANNER_PUBLIC_URL=https://your-cloud-run-url.run.app
VITE_SCANNER_PUBLIC_URL=https://your-cloud-run-url.run.app
BACKEND_GCP_PROJECT=houseyield
BACKEND_GCP_REGION=us-central1
BACKEND_GCP_SERVICE=houseyield-backend
BACKEND_GCP_SERVICE_ACCOUNT_NAME=houseyield-backend-runtime
BACKEND_GCP_SERVICE_ACCOUNT=houseyield-backend-runtime@houseyield.iam.gserviceaccount.com
BACKEND_GCP_ARTIFACT_LOCATION=us-central1
BACKEND_GCP_ARTIFACT_REPOSITORY=houseyield-backend
BACKEND_GCP_MEMORY=4Gi
BACKEND_GCP_CPU=2
# Keep >=1 so Shelly BLE webhooks / climate history don't die on cold starts.
# Scale-to-zero made H&T charts go blank whenever the laptop wasn't running.
BACKEND_GCP_MIN_INSTANCES=1
BACKEND_GCP_MAX_INSTANCES=10
BACKEND_GCP_TIMEOUT=900
FRONTEND_URL=https://app.example.com
STRIPE_CONNECT_FRONTEND_URL=https://myhouseyield.com

# HouseYield platform SaaS subscription (Stripe Billing — separate from Stripe Connect)
# Recurring monthly Price IDs (create Products/Prices in Stripe; never commit live secrets)
#   STRIPE_PRICE_LIGHT    → Protection tier ($19/mo)
#   STRIPE_PRICE_STANDARD → Hands-Off tier ($49/mo)
#   STRIPE_PRICE_PREMIUM  → Fully Managed tier ($79/mo)
STRIPE_PRICE_LIGHT=price_xxx_protection_monthly
STRIPE_PRICE_STANDARD=price_xxx_hands_off_monthly
STRIPE_PRICE_PREMIUM=price_xxx_fully_managed_monthly
# Signing secret for the subscription webhook endpoint (/api/subscriptions/webhook)
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_xxx
# Optional dev escape hatch: allow completing onboarding without an active subscription
# ONBOARDING_ALLOW_WITHOUT_SUBSCRIPTION=1
ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Master v1 Canonical GPU Worker (separate from room-tour)
MASTER_V1_GCP_WORKER_ENABLE=false
MASTER_V1_GCP_HOST=
MASTER_V1_GCP_TRANSPORT=gcloud
MASTER_V1_GCP_WORKER_USER=
MASTER_V1_GCP_KEEP_REMOTE_ARTIFACTS=false
MASTER_V1_GCP_VM_NAME=master-v1-gpu-2xl4-useast1b
MASTER_V1_GCP_VM_ZONE=us-east1-b
MASTER_V1_GCP_VM_PROJECT=silken-slice-480417-e0
MASTER_V1_GCP_MACHINE_TYPE=g2-standard-24
MASTER_V1_GCP_GPU_TYPE=nvidia-l4
MASTER_V1_GCP_GPU_COUNT=2
MASTER_V1_GCP_BOOT_DISK_SIZE_GB=200
MASTER_V1_GCP_BOOT_DISK_TYPE=pd-ssd
MASTER_V1_GCP_IMAGE_FAMILY=common-cu129-ubuntu-2204-nvidia-580
MASTER_V1_GCP_IMAGE_PROJECT=deeplearning-platform-release
MASTER_V1_GCP_SERVICE_DIR=/opt/master-v1-service
MASTER_V1_GCP_DATA_DIR=/opt/master-v1-data
MASTER_V1_GCP_VENV_PATH=/opt/master-v1-venv
MASTER_V1_GCP_PYTHON_PATH=/opt/master-v1-venv/bin/python3

# Cloud Run runtime should use an attached service account, not a local ADC file.
# Do not set GOOGLE_APPLICATION_CREDENTIALS in production.

# Backend Server Configuration
PORT=3001

# Security - Encryption Key for Sensitive Data (Plaid tokens, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_here_64_characters_long

# Google Search API (for service provider search)
# You need TWO keys in practice:
# 1) Browser key (HTTP referrer restricted) → VITE_GOOGLE_MAPS_API_KEY for maps/street view in the UI
# 2) Server key (NO referrer restriction) → GOOGLE_SERVER_API_KEY for maintenance provider search
#
# Setup:
# - Google Cloud Console → APIs & Services → Library → enable:
#     Geocoding API, Places API (New), Custom Search API
# - Credentials → Create API key → Application restrictions: None (dev) or IP addresses (prod)
# - API restrictions: restrict to the three APIs above
# - Programmable Search Engine ID → GOOGLE_CSE_CX (https://programmablesearchengine.google.com/)
# - Verify: node scripts/verify-google-server-key.mjs
VITE_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_key_here
GOOGLE_SEARCH_API_KEY=your_server_side_google_api_key_here
GOOGLE_MAPS_API_KEY=your_server_side_google_api_key_here
GOOGLE_SERVER_API_KEY=your_server_side_google_api_key_here
GOOGLE_CSE_CX=your_custom_search_engine_id_here

# OpenAI API (for AI-powered ranking and extraction)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ATTOM Data API (for property data)
ATTOM_API_KEY=your_attom_api_key_here

# FRED API (for housing market data)
FRED_API_KEY=your_fred_api_key_here

# FBI Crime Data Explorer API (free from https://api.data.gov/signup/)
FBI_CRIME_API_KEY=your_fbi_crime_api_key_here

# RentCast API (for ZIP-level sale and rent market aggregates)
RENTCAST_API_KEY=your_rentcast_api_key_here

# Rental Listing Syndication APIs
# Facebook Marketplace
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Zillow Rental Manager (includes Trulia & HotPads)
ZILLOW_API_KEY=your_zillow_api_key_here
ZILLOW_PARTNER_ID=your_zillow_partner_id_here

# Apartments.com
APARTMENTS_COM_API_KEY=your_apartments_com_api_key_here
APARTMENTS_COM_ACCOUNT_ID=your_apartments_com_account_id_here

# Contact Information (for listings)
CONTACT_EMAIL=your_rental_contact@example.com
CONTACT_PHONE=+1-555-123-4567

# Environmental Risk API Keys
# Server-side key preferred for /api/property-weather (falls back to VITE_ if unset).
OPENWEATHER_API_KEY=your_openweather_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_key_here
VITE_USGS_API_KEY=your_usgs_key_here
VITE_AIRNOW_API_KEY=your_airnow_key_here
VITE_FEMA_ENDPOINT=https://www.fema.gov/api/open

# Gmail Configuration (for appointment and tenant emails)
HOUSEYIELD_EMAIL_ADDRESS=admin@myhouseyield.com
HOUSEYIELD_EMAIL_PASSWORD=your_google_app_password_here

# Twilio Voice Call Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY_SID=your_twilio_api_key_sid_here
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_here
TWILIO_FROM_NUMBER=+1234567890
# Recommended for US SMS: Messaging Service with approved A2P 10DLC Campaign
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Maintenance owner SMS confirmations (requires Twilio + owner phone on profile)
MAINTENANCE_OWNER_SMS_ENABLED=1
# Set to 0 to allow provider calls immediately without waiting for owner SMS YES
MAINTENANCE_OWNER_SMS_BLOCK_DISPATCH=1
# Require a second owner SMS YES before calling the selected maintenance provider
MAINTENANCE_OWNER_SMS_REQUIRE_PROVIDER_APPROVAL=1
# Dev/test: route owner SMS and practice booking calls to this number instead of real owners/providers
MAINTENANCE_OWNER_SMS_TEST_PHONE=+12026420437
TWILIO_TEST_TO_NUMBER=+12026420437
# Allowed practice targets shown in the maintenance UI selector (label|+E164, comma-separated)
MAINTENANCE_PRACTICE_TEST_PHONES=Griffin (DC) — (202) 642-0437|+12026420437
# Keep booking calls on the test number even when deployed until you are ready to call real providers
MAINTENANCE_PRACTICE_MODE=1
# Practice booking calls always route here after owner SMS approval (default Griffin)
MAINTENANCE_PRACTICE_CALL_PHONE=+12026420437
# Twilio inbound SMS webhook (POST): https://YOUR_BACKEND_URL/twilio/sms/inbound
# Cloud Run: set Twilio "A call comes in" webhook (POST) to:
# https://YOUR_CLOUD_RUN_BACKEND_URL/twiml/inbound-voice
# Example: https://houseyield-backend-xxxxx-uc.a.run.app/twiml/inbound-voice
BACKEND_PUBLIC_URL=https://your-backend-service-uc.a.run.app
PUBLIC_URL=https://your-backend-service-uc.a.run.app

# Shelly native cloud ingestion — devices POST to the public Cloud Run backend
# (Derived automatically from BACKEND_PUBLIC_URL when SHELLY_WEBHOOK_URL is unset.)
# BLU H&T history MUST use this Cloud Run URL. Local push-server is optional only.
# Keep BACKEND_GCP_MIN_INSTANCES>=1 and schedule /api/shelly/climate-history/tick
# (see scripts/ensure-iot-climate-scheduler.sh) so charts don't die when idle.
SHELLY_WEBHOOK_URL=https://your-backend-service-uc.a.run.app/api/shelly/webhook
VITE_SHELLY_WEBHOOK_URL=https://your-backend-service-uc.a.run.app/api/shelly/webhook
# Legacy alias kept for older scripts; prefer SHELLY_WEBHOOK_URL above.
SHELLY_FIREBASE_WEBHOOK_URL=https://your-backend-service-uc.a.run.app/api/shelly/webhook
VITE_SHELLY_FIREBASE_WEBHOOK_URL=https://your-backend-service-uc.a.run.app/api/shelly/webhook

# Public backend URL used for Shelly outbound WebSocket + webhook defaults
SHELLY_SERVER_PUBLIC_URL=https://your-backend-service-uc.a.run.app
VITE_SHELLY_SERVER_PUBLIC_URL=https://your-backend-service-uc.a.run.app

# Internal ops console (staff-only; separate frontend on port 5174 in dev)
# Comma-separated Firebase auth emails allowed to use absentee search + outreach APIs
HOUSEYIELD_INTERNAL_STAFF_EMAILS=you@myhouseyield.com
VITE_INTERNAL_STAFF_EMAILS=you@myhouseyield.com
# Required on Cloud Run for ops console (/api/attom/absentee-search, /api/internal/*)
VITE_CUSTOMER_APP_URL=http://127.0.0.1:5173
# Production example: deploy dist-internal to ops.myhouseyield.com and add to ALLOWED_ORIGINS

# Voice Call Security - CRITICAL IN PRODUCTION!
# Generate a secure random string: openssl rand -base64 32
VOICE_API_KEY=generate_a_secure_random_api_key_here
BLOCKED_NUMBERS=+15555555555,+15555555556

# Security - CHANGE THIS IN PRODUCTION!
APPOINTMENT_TOKEN_SECRET=generate_a_strong_random_secret_here

# Playwright Automation
PLAYWRIGHT_ENABLED=1
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADFUL=0
PLAYWRIGHT_TIMEOUT_MS=45000
PLAYWRIGHT_ROUTE_TIMEOUT_MS=65000
PLAYWRIGHT_FALLBACK_ALWAYS=0

# Optional fallback contact info
FALLBACK_CONTACT_EMAIL=noreply@example.com
FALLBACK_CONTACT_PHONE=

# Debug flags
DEBUG_SEARCH=0
HEADFUL=0

